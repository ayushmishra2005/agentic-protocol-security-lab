# Copy to .env for local development. Never commit a real .env.
# This key is read only by host model-client code, which does not exist yet. That
# host-to-provider inference call is the single permitted outbound network path: no
# tool reachable by the model, and nothing in an analysed repository, can cause
# network access.
ANTHROPIC_API_KEY=your_key_here

# Optional: absolute path to the dpm executable.
# Defaults to ~/.dpm/bin/dpm. Ambient PATH is never consulted.
# DPM_BIN=/absolute/path/to/dpm

# Optional: absolute path to the git executable. Defaults to /usr/bin/git.
# GIT_BIN=/usr/bin/git

# Optional: override the pinned model identifier.
# SECURITY_LAB_MODEL=
